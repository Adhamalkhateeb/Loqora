@model Loqora.Infrastructure.Services.Email.Models.EmailConfirmationModel

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Confirm Your Email — @Model.CompanyName</title>
    <style type="text/css">
        /* Reset */
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
        body { margin: 0; padding: 0; width: 100% !important; height: 100% !important; }

        /* Base */
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f0f2f5;
            color: #1a1a2e;
        }

        .email-wrapper {
            width: 100%;
            background-color: #f0f2f5;
            padding: 40px 0;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        }

        /* Header */
        .email-header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 40px 40px 36px;
            text-align: center;
        }

        .email-header .logo-text {
            font-size: 32px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 2px;
            margin: 0;
        }

        .email-header .logo-accent {
            color: #e94560;
        }

        .email-header .tagline {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.6);
            margin-top: 6px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Body */
        .email-body {
            padding: 44px 40px 36px;
        }

        .greeting {
            font-size: 22px;
            font-weight: 600;
            color: #1a1a2e;
            margin: 0 0 16px;
        }

        .message-text {
            font-size: 15px;
            line-height: 1.7;
            color: #4a4a68;
            margin: 0 0 32px;
        }

        /* CTA Button */
        .cta-wrapper {
            text-align: center;
            margin: 0 0 32px;
        }

        .cta-button {
            display: inline-block;
            padding: 14px 40px;
            background: linear-gradient(135deg, #e94560 0%, #c23152 100%);
            color: #ffffff !important;
            text-decoration: none;
            font-size: 15px;
            font-weight: 600;
            border-radius: 8px;
            letter-spacing: 0.5px;
            transition: all 0.2s;
            box-shadow: 0 4px 14px rgba(233, 69, 96, 0.35);
        }

        /* Fallback link */
        .fallback-section {
            background-color: #f8f9fb;
            border-radius: 8px;
            padding: 20px 24px;
            margin: 0 0 32px;
        }

        .fallback-label {
            font-size: 12px;
            font-weight: 600;
            color: #8a8aaa;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 8px;
        }

        .fallback-link {
            font-size: 13px;
            color: #0f3460;
            word-break: break-all;
            line-height: 1.5;
        }

        /* Divider */
        .divider {
            height: 1px;
            background-color: #eaedf2;
            margin: 0 0 24px;
        }

        /* Notice */
        .notice-text {
            font-size: 13px;
            line-height: 1.6;
            color: #8a8aaa;
            margin: 0;
        }

        /* Footer */
        .email-footer {
            background-color: #f8f9fb;
            padding: 28px 40px;
            text-align: center;
            border-top: 1px solid #eaedf2;
        }

        .footer-text {
            font-size: 12px;
            color: #8a8aaa;
            line-height: 1.6;
            margin: 0;
        }

        .footer-text a {
            color: #e94560;
            text-decoration: none;
        }

        /* Responsive */
        @@media only screen and (max-width: 620px) {
            .email-wrapper { padding: 20px 16px !important; }
            .email-header { padding: 28px 24px 24px !important; }
            .email-body { padding: 32px 24px 28px !important; }
            .email-footer { padding: 20px 24px !important; }
            .greeting { font-size: 20px !important; }
            .cta-button { padding: 12px 32px !important; }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" class="email-container">
            <!-- Header -->
            <tr>
                <td class="email-header">
                    <p class="logo-text">R<span class="logo-accent">o</span>va</p>
                    <p class="tagline">Hotel Management</p>
                </td>
            </tr>

            <!-- Body -->
            <tr>
                <td class="email-body">
                    <p class="greeting">Hello @Model.RecipientName,</p>

                    <p class="message-text">
                        Welcome to <strong>@Model.CompanyName</strong>! We're thrilled to have you on board.
                        To get started, please confirm your email address by clicking the button below.
                    </p>

                    <div class="cta-wrapper">
                        <a href="@Model.ConfirmationLink" class="cta-button" target="_blank">
                            Confirm My Email
                        </a>
                    </div>

                    <div class="fallback-section">
                        <p class="fallback-label">Button not working? Copy this link:</p>
                        <p class="fallback-link">@Model.ConfirmationLink</p>
                    </div>

                    <div class="divider"></div>

                    <p class="notice-text">
                        If you didn't create an account with @Model.CompanyName, you can safely ignore this email.
                        This link will expire in 24 hours.
                    </p>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td class="email-footer">
                    <p class="footer-text">
                        &copy; @Model.Year @Model.CompanyName. All rights reserved.<br />
                        Need help? Contact us at <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>
                    </p>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
